# Frontend local development environment. Copy to .env and configure as needed.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exact comma-separated storage origins that Next.js may optimize. Include the
# scheme and port; do not include a path or a trailing bucket name.
NEXT_IMAGE_REMOTE_ORIGINS=http://127.0.0.1:9000

# Optional overrides; these defaults are already built into the application
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif
NEXT_PUBLIC_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/x-m4a,audio/aac
