# Browser-visible application endpoints (values are embedded at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Comma-separated hostnames that Next.js may optimize when returned by the API
NEXT_PUBLIC_ALLOWED_IMAGE_DOMAINS=christianvieux-trackfusionweb-storage-bucket.s3.us-east-1.amazonaws.com

# Optional overrides; these defaults are already built into the application
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif
NEXT_PUBLIC_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/x-m4a,audio/aac
